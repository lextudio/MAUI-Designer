<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- LibreWPF.Sdk is a NuGet-delivered MSBuild SDK, and OpenDevelop builds against a local
         feed for it rather than nuget.org. Resolved from this repository, the relative path
         from OpenDevelop's own nuget.config does not apply, so it is spelled out here. -->
    <add key="librewpf-local" value="../../openavalon/artifacts/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="librewpf-local">
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
