<Project Sdk="Microsoft.NET.Sdk">
  <!-- maui-xaml-ls: the XAML language server for .NET MAUI projects, and only for them. Every XAML
       runtime has its own server (OpenDevelop's wpf-xaml-ls, librewpf-xaml-ls, winui-xaml-ls,
       progpu-winui-xaml-ls, uno-xaml-ls); see OpenDevelop's doc/technotes/xaml-language-servers.md.
       MIT, like the rest of this folder: it uses OpenDevelop's MIT XAML engine (wxsg), never the
       GPL code in ../maui-designer-native. It reads MAUI metadata only - no MAUI runtime or workload
       is needed to build or run it. The addin bundles it next to itself (LanguageServer/). -->
  <PropertyGroup>
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == ''">$(OPENDEVELOP_ROOT)</OpenDevelopRoot>
    <OpenDevelopRoot>$([MSBuild]::EnsureTrailingSlash('$(OpenDevelopRoot)'))</OpenDevelopRoot>
    <XamlEngineRoot>$(OpenDevelopRoot)externals/vscode-wpf/external/wxsg/external/XamlToCSharpGenerator/src/</XamlEngineRoot>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>maui-xaml-ls</AssemblyName>
    <RootNamespace>MAUIDesigner.LanguageServer</RootNamespace>
    <!-- Started by path as a managed dll (dotnet exec), never through an apphost. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <Target Name="ValidateOpenDevelopRoot" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(XamlEngineRoot)XamlToCSharpGenerator.LanguageServer/XamlToCSharpGenerator.LanguageServer.csproj')"
           Text="Point OpenDevelopRoot (or the OPENDEVELOP_ROOT environment variable) at an OpenDevelop checkout with its submodules, e.g. -p:OpenDevelopRoot=/Users/lextm/wpf-tools/OpenDevelop" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(XamlEngineRoot)XamlToCSharpGenerator.LanguageServer/XamlToCSharpGenerator.LanguageServer.csproj" />
    <ProjectReference Include="$(XamlEngineRoot)XamlToCSharpGenerator.LanguageService/XamlToCSharpGenerator.LanguageService.csproj" />
    <ProjectReference Include="$(XamlEngineRoot)XamlToCSharpGenerator.LanguageService.Framework.Maui/XamlToCSharpGenerator.LanguageService.Framework.Maui.csproj" />
  </ItemGroup>
</Project>
