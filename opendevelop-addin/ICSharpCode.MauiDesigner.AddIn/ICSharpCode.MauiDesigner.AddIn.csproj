<Project Sdk="LibreWPF.Sdk">

  <PropertyGroup>
    <OpenDevelopRoot Condition="'$(OpenDevelopRoot)' == ''">$(OPENDEVELOP_ROOT)</OpenDevelopRoot>
    <OpenDevelopRoot>$([MSBuild]::EnsureTrailingSlash('$(OpenDevelopRoot)'))</OpenDevelopRoot>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ICSharpCode.MauiDesigner</AssemblyName>
    <RootNamespace>ICSharpCode.MauiDesigner</RootNamespace>
    <!-- An external addin is never deployed into an OpenDevelop tree: it is debugged and tested
         in a running OpenDevelop through the Addin SDK's -addindir: launch (as CoreWF's
         WorkflowDesigner is). So it builds into its own folder, and that folder IS the addin. -->
    <OutputPath>$(MSBuildThisFileDirectory)bin/$(Configuration)/</OutputPath>
    <OpenDevelopHostBin Condition="'$(OpenDevelopHostBin)' == '' And '$(OPENDEVELOP_APP_PATH)' != ''">$([System.IO.Path]::GetDirectoryName('$(OPENDEVELOP_APP_PATH)'))/</OpenDevelopHostBin>
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)' != ''">$(OPENDEVELOP_ADDIN_TEST_DEVFLOW_PORT)</OpenDevelopDebugDevFlowPort>
    <!-- OpenDevelopAppFixture sets OD_TEST_MODE only for integration-test host processes. 9302, not
         CoreWF's 9301, so both addins' suites can run on one machine. -->
    <OpenDevelopDebugDevFlowPort Condition="'$(OpenDevelopDebugDevFlowPort)' == '' And '$(OD_TEST_MODE)' == '1'">9302</OpenDevelopDebugDevFlowPort>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="ValidateOpenDevelopRoot" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props')"
           Text="Point OpenDevelopRoot (or the OPENDEVELOP_ROOT environment variable) at an OpenDevelop checkout, e.g. -p:OpenDevelopRoot=/Users/lextm/wpf-tools/OpenDevelop" />
  </Target>

  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props" Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.props')" />

  <ItemGroup>
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Base/Project/ICSharpCode.SharpDevelop.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/ICSharpCode.SharpDevelop.Widgets/Project/ICSharpCode.SharpDevelop.Widgets.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Remote/Designer.Remote.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Shell/Designer.Shell.csproj" Private="false" />
    <ProjectReference Include="$(OpenDevelopRoot)src/Main/Designer/Designer.Presentation/Designer.Presentation.csproj" Private="false" />
    <!-- The shared design canvas (OpenDevelop's ICSharpCode.DesignerCanvas addin, MIT): this addin
         supplies only its MAUI backend. Loaded from that addin at run time (see MauiDesigner.addin). -->
    <ProjectReference Include="$(OpenDevelopRoot)src/AddIns/DisplayBindings/DesignerCanvas/ICSharpCode.DesignerCanvas.csproj" Private="false" />
    <!-- The shared Properties pad is Xceed's PropertyGrid: IPropertyGridEventSource for its Events view. -->
    <ProjectReference Include="$(OpenDevelopRoot)externals/wpftoolkit/ExtendedWPFToolkitSolution/Src/Xceed.Wpf.Toolkit/Xceed.Wpf.Toolkit.csproj" Private="false" />
    <!-- MIT siblings only. This addin is MIT-licensed and must not reference, link or source-include
         anything from ../maui-designer-native (GPL); it talks to the GPL design host over DDP only. -->
    <ProjectReference Include="..\MAUIDesigner.Dialect\MAUIDesigner.Dialect.csproj" />
    <ProjectReference Include="..\MAUIDesigner.Ddp.Client\MAUIDesigner.Ddp.Client.csproj" />
  </ItemGroup>

  <!--
    Bundling the design host: the GPL DDP host apps are built in ../maui-designer-native on their
    own and copied, as separate programs, into Host/ beside this addin (mere aggregation - the
    addin starts them as child processes and talks JSON-RPC; nothing is linked). There is no
    ProjectReference to them: point MauiDesignHostOutput at their build output, or build them first
    at the default location. MauiDesignerViewContent.LocateHost looks in Host/; the Addin SDK
    exempts .../Host/ folders from parent-assembly trimming.
  -->
  <PropertyGroup>
    <MauiDesignHostRoot Condition="'$(MauiDesignHostRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../maui-designer-native/'))</MauiDesignHostRoot>
    <_MauiRid>osx-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_MauiRid>
    <MauiModelHostOutput Condition="'$(MauiModelHostOutput)' == ''">$(MauiDesignHostRoot)MAUIDesigner.Ddp.Host/bin/$(Configuration)/net10.0/</MauiModelHostOutput>
    <MauiNativeMacHostBundle Condition="'$(MauiNativeMacHostBundle)' == ''">$(MauiDesignHostRoot)MAUIDesigner.Host/bin/$(Configuration)/net10.0-macos/$(_MauiRid)/MAUIDesigner.Host.app</MauiNativeMacHostBundle>
  </PropertyGroup>

  <!-- The MAUI XAML language server (maui-xaml-ls), bundled next to the addin under LanguageServer/
       and registered for the MAUI dialect by MauiDesignerDisplayBinding.RegisterDialect. Built with
       the addin; not referenced - it is a separate process. -->
  <ItemGroup>
    <ProjectReference Include="../MAUIDesigner.LanguageServer/MAUIDesigner.LanguageServer.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>
  <Target Name="BundleLanguageServer" AfterTargets="Build">
    <ItemGroup>
      <_MauiLanguageServerFile Include="$(MSBuildProjectDirectory)/../MAUIDesigner.LanguageServer/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Warning Condition="'@(_MauiLanguageServerFile)' == ''" Text="maui-xaml-ls is not built; MAUI XAML will have no language service." />
    <Copy SourceFiles="@(_MauiLanguageServerFile)" DestinationFiles="@(_MauiLanguageServerFile->'$(OutputPath)LanguageServer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleDesignHosts" AfterTargets="Build">
    <Warning Condition="!Exists('$(MauiModelHostOutput)MAUIDesigner.Ddp.Host.dll')"
             Text="The MAUI model-only design host is not built ($(MauiModelHostOutput)); build ../maui-designer-native/MAUIDesigner.Ddp.Host first to bundle it." />
    <ItemGroup Condition="Exists('$(MauiModelHostOutput)MAUIDesigner.Ddp.Host.dll')">
      <_MauiModelHostFile Include="$(MauiModelHostOutput)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MauiModelHostFile)" DestinationFiles="@(_MauiModelHostFile->'$(OutputPath)Host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Warning Condition="$([MSBuild]::IsOSPlatform('OSX')) And !Exists('$(MauiNativeMacHostBundle)')"
             Text="The native MAUI design host is not built ($(MauiNativeMacHostBundle)); build ../maui-designer-native/MAUIDesigner.Host first to bundle it." />
    <!-- ditto, not <Copy>: a bundle carries symlinks and executable bits that <Copy> loses. -->
    <RemoveDir Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(MauiNativeMacHostBundle)')" Directories="$(OutputPath)Host/MAUIDesigner.Host.app" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(MauiNativeMacHostBundle)')"
          Command="ditto &quot;$(MauiNativeMacHostBundle)&quot; &quot;$(OutputPath)Host/MAUIDesigner.Host.app&quot;" />
  </Target>


  <ItemGroup>
    <None Include="MauiDesigner.addin" />
    <!-- Compile-only: the OpenDevelop host supplies the DevFlow agent at runtime. -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.Core" Version="0.2.7" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets" Condition="Exists('$(OpenDevelopRoot)src/SDK/OpenDevelop.Addin.Sdk/Sdk/Sdk.targets')" />

</Project>
